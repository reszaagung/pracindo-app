%% FASE 3 — OPSI 2: app mandiri + event log transisi
%% Semua perbaikan Opsi 1, DITAMBAH: status jadi turunan dari tabel transisi
%% append-only. `selesai` dipertahankan sebagai cache demi kontrak frontend.
%% render: mmdc -i 03-tobe-2-flow.mmd -o 03-tobe-2-flow.svg
flowchart LR

  subgraph CLIENT["Client — pracindo-frontend"]
    direction TB
    FE1["fetchMading() · fetchSemua()<br/>fetchStaffList() · buatWO() · approveWO()<br/>KONTRAK IDENTIK — wo.selesai tetap ada"]
    FE2["staffId = accessCard.profil.id<br/>+ useAuth() export accessCard<br/><small>DIPERBAIKI</small>"]
    FE3["(opsional, tidak wajib)<br/>riwayat = wo.transisi[]<br/>panel jejak persetujuan"]
  end

  subgraph URL["URL"]
    U1["10 endpoint lama — IDENTIK"]
    U2["GET /work-order/{id}/riwayat/ — BARU<br/>tidak dipakai FE, aditif"]
  end

  subgraph VIEW["View"]
    direction TB
    V0["WorkOrderViewSet<br/>modul='work_order' + AksesModul"]
    V1["mading() · list() · staff()<br/>request.user.id"]
    V2["approve() -> services.setujui()"]
    V3["riwayat() — BARU"]
    V4["kirim_pesan() -> services.kirim_pesan()"]
  end

  subgraph SER["Serializer"]
    S1["WorkOrderSerializer<br/>selesai (cache) + status + transisi[]"]
    S2["TransisiSerializer — BARU"]
    S3["PesanChatSerializer · PenugasanSerializer<br/>DetailProduksiSerializer · ProfilStaffRingkasSerializer"]
  end

  subgraph SVC["Service — satu pintu untuk semua transisi"]
    direction TB
    C0["_catat_transisi()<br/>append-only + idempotency_key<br/>select_for_update pada WorkOrder"]
    C1["buat_work_order()"]
    C2["setujui_work_order()<br/>mesin aturan SALAH_SATU/SEMUA/PIC"]
    C3["batalkan_work_order() — BARU"]
    C4["kirim_pesan()"]
    C5["nomor_berikutnya() -> CounterDokumen"]
  end

  subgraph MODEL["Model"]
    direction TB
    M1["WorkOrder<br/>status + selesai (cache)"]
    M2["WorkOrderTransisi — BARU<br/>append-only, save/delete diblokir"]
    M3["WorkOrderPenugasan"]
    M4["WorkOrderPesan"]
    M5["DetailPesananProduksi"]
    M6["core.CounterDokumen"]
  end

  subgraph DB["PostgreSQL"]
    T1[("wo_work_order")]
    T2[("wo_transisi — BARU")]
    T3[("wo_penugasan")]
    T4[("wo_pesan — migrasi 0002")]
    T5[("wo_detail_produksi — migrasi 0002")]
  end

  FE1 --> U1 --> V0
  FE2 -.-> V1
  FE3 -.-> U2 --> V3
  V0 --> V1
  V0 --> V2
  V0 --> V4
  V1 --> S1
  V2 --> C2
  V3 --> S2
  V4 --> C4
  S1 --> S2
  S1 --> S3

  C1 --> C0
  C2 --> C0
  C3 --> C0
  C1 --> C5 --> M6
  C0 ==>|"tulis event LALU perbarui cache<br/>dalam satu atomic"| M2
  C0 ==> M1
  C2 --> M3
  C4 --> M4
  C1 --> M5

  M1 --> T1
  M2 --> T2
  M3 --> T3
  M4 --> T4
  M5 --> T5

  classDef baru fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20,stroke-width:2px
  classDef tetap fill:#eceff1,stroke:#607d8b,color:#37474f
  classDef fe fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
  classDef inti fill:#ede7f6,stroke:#5e35b1,color:#311b92,stroke-width:3px

  class FE1 fe
  class FE2,FE3 baru
  class U1,S3,M3,M5,T1,T3 tetap
  class U2,V3,S2,M2,T2,C3,T4,T5 baru
  class C0,M1 inti
  class V0,V1,V2,V4,S1,C1,C2,C4,C5,M4,M6 baru
