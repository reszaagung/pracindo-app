%% FASE 3 — OPSI 1: Perbaikan minimal di tempat
%% work_order tetap app mandiri. Status tetap boolean `selesai`.
%% Yang berubah hanya yang RUSAK. Kontrak frontend tidak disentuh sama sekali.
%% render: mmdc -i 03-tobe-1-flow.mmd -o 03-tobe-1-flow.svg
flowchart LR

  subgraph CLIENT["Client — pracindo-frontend (2 baris berubah)"]
    direction TB
    FE1["fetchMading() · fetchSemua()<br/>fetchStaffList() · buatWO()<br/>TIDAK BERUBAH"]
    FE2["staffId = accessCard.profil.id<br/><small>useWorkOrder.js:17 DIPERBAIKI</small>"]
    FE3["useAuth() meng-export accessCard<br/><small>useAuth.js — DITAMBAH</small>"]
  end

  subgraph URL["URL — work_order/urls.py (tetap)"]
    U1["10 endpoint, path & method IDENTIK"]
  end

  subgraph VIEW["View — work_order/views.py"]
    direction TB
    V0["WorkOrderViewSet<br/>modul = 'work_order' DITAMBAH<br/>permission_classes =<br/>[AksesModul, CanAksesWorkOrder]"]
    V1["get_queryset()<br/>prefetch aman<br/>filterset_fields = selesai, tanggal"]
    V2["mading()<br/>user_staff_id = request.user.id<br/><small>DIPERBAIKI</small>"]
    V3["approve()<br/>request.user.id + return final<br/><small>DIPERBAIKI (N1)</small>"]
    V4["staff() — TIDAK BERUBAH"]
    V5["kirim_pesan()"]
    P1["CanAksesWorkOrder<br/>+ has_permission()<br/>+ request.user.id<br/><small>DIPERBAIKI</small>"]
  end

  subgraph SER["Serializer"]
    S1["WorkOrderSerializer<br/>staff_ids -> PrimaryKeyRelatedField<br/>pic_id divalidasi ada di staff_ids"]
    S2["PesanChatSerializer · PenugasanSerializer<br/>DetailProduksiSerializer · ProfilStaffRingkasSerializer"]
  end

  subgraph SVC["Service — work_order/services.py (DIISI)"]
    C1["buat_work_order()<br/>pindah dari serializers.create()"]
    C2["setujui_work_order()<br/>pindah dari views.approve()"]
    C3["nomor_berikutnya()<br/>pakai core.CounterDokumen"]
  end

  subgraph MODEL["Model — struktur TETAP"]
    M1["WorkOrder<br/>+ CheckConstraint INV-7<br/>save() tidak lagi menomori"]
    M2["WorkOrderPenugasan<br/>staff -> PROTECT"]
    M3["WorkOrderPesan<br/>pengirim -> PROTECT"]
    M4["DetailPesananProduksi"]
    M5["core.CounterDokumen<br/>select_for_update"]
  end

  subgraph DB["PostgreSQL"]
    T1[("wo_work_order")]
    T2[("wo_penugasan")]
    T3[("wo_pesan<br/>DIBUAT migrasi 0002")]
    T4[("wo_detail_produksi<br/>DIBUAT migrasi 0002")]
    T5[("core_counter_dokumen")]
  end

