%% FASE 1 — AS-IS dependensi work_order
%% Aturan lapis dideklarasikan pracindo_erp/settings.py:75-96
%%   Lapis 1 core, staff_user | Lapis 2 master, dokumen | Lapis 3 inventory
%%   Lapis 4 akunting, keuangan, pajak, warehouse, produksi,
%%           sales_order, logistik, work_order  (boleh saling panggil DI DALAM FUNGSI)
%% render: mmdc -i 01-asis-deps.mmd -o 01-asis-deps.svg
flowchart TB

  subgraph L1["Lapis 1 — fondasi"]
    CORE["core"]
    STAFF["staff_user"]
  end

  subgraph L3["Lapis 3"]
    INV["inventory"]
  end

  subgraph L4["Lapis 4 — kelompok sejajar"]
    WO["work_order"]
    PROD["produksi"]
    WH["warehouse"]
    AKUN["akunting"]
    KEU["keuangan"]
  end

  %% ---- import work_order KELUAR (tingkat modul) ----
  WO -->|"views.py:10 from staff_user.models import Profil"| STAFF
  WO -->|"serializers.py:4 from staff_user.models import Profil"| STAFF

  %% ---- yang TIDAK ada ----
  WO -.->|"TIDAK ADA import ke core.models<br/>satu-satunya app transaksional<br/>tanpa TimeStampedModel/DiauditModel (N4)"| CORE
  WO -.->|"services.py:19 docstring menjanjikan<br/>cek stok ke warehouse — fungsi hanya pass"| WH
  WO -.->|"tidak ada relasi ke Entitas<br/>work_order buta-entitas"| CORE

  %% ---- fan-in ----
  NOBODY["(tidak ada app yang<br/>mengimpor work_order)<br/>fan-in = 0"]
  NOBODY -.-> WO

  %% ---- akses model app lain ----
  WO ==>|"views.py:50 Profil.objects.aktif()<br/>BACA model app lain, tidak lewat services.py"| STAFF

  %% ---- pembanding: pelanggaran nyata di app lain (konteks) ----
  KEU -->|"services.py:7 MODULE — V1 melanggar"| AKUN
  WH -->|"views.py:19 + serializers.py:19 MODULE — V2 melanggar"| AKUN

  classDef bersih fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
  classDef netral fill:#eceff1,stroke:#607d8b,color:#37474f
  classDef langgar fill:#ffebee,stroke:#c62828,color:#b71c1c
  classDef hilang fill:#f5f5f5,stroke:#bdbdbd,color:#9e9e9e,stroke-dasharray:5 3

  class WO bersih
  class CORE,STAFF,INV,PROD netral
  class AKUN,KEU,WH langgar
  class NOBODY hilang

  linkStyle 0,1 stroke:#2e7d32,stroke-width:2px
  linkStyle 2,3,4,5 stroke:#bdbdbd,stroke-dasharray:5 3
  linkStyle 6 stroke:#f9a825,stroke-width:2px
  linkStyle 7,8 stroke:#c62828,stroke-width:3px
