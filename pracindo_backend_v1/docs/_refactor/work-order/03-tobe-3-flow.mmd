%% FASE 3 — OPSI 3: pisah per jenis pekerjaan
%% work_order jadi MURNI papan tugas + diskusi.
%% Pesanan produksi pindah ke app `produksi` dan ditulis HANYA lewat
%% produksi/services.py, sehingga penjaga periode & stok yang sudah ada
%% berlaku untuknya.
%% render: mmdc -i 03-tobe-3-flow.mmd -o 03-tobe-3-flow.svg
flowchart LR

  subgraph CLIENT["Client — pracindo-frontend"]
    direction TB
    FE1["fetchMading() · fetchSemua()<br/>fetchStaffList() · buatWO() · approveWO()<br/>KONTRAK IDENTIK"]
    FE2["staffId = accessCard.profil.id<br/><small>DIPERBAIKI</small>"]
    FE3["(layar baru, belum ada)<br/>form Pesanan Produksi<br/>-> /api/v1/produksi/pesanan/"]
  end

  subgraph WOAPP["app work_order — MURNI kolaborasi"]
    direction TB
    U1["10 endpoint lama<br/>tanpa detail_produksi di payload"]
    V0["WorkOrderViewSet<br/>modul='work_order' + AksesModul"]
    V1["mading() · staff() · approve()<br/>kirim_pesan() — request.user.id"]
    S1["WorkOrderSerializer<br/>DetailProduksiSerializer DIHAPUS"]
    C1["services: buat_work_order()<br/>setujui_work_order() · kirim_pesan()<br/>+ transisi append-only"]
    M1["WorkOrder · WorkOrderPenugasan<br/>WorkOrderPesan · WorkOrderTransisi"]
  end

  subgraph PRODAPP["app produksi — pemilik domain produksi"]
    direction TB
    U2["POST /api/v1/produksi/pesanan/ — BARU"]
    U3["POST /api/v1/produksi/pesanan/{id}/setujui/ — BARU"]
    V2["PesananProduksiViewSet — BARU<br/>modul='produksi' + AksesModul"]
    S2["PesananProduksiSerializer — BARU"]
    C2["services.buat_pesanan() — BARU<br/>satu-satunya pintu tulis"]
    C3["services.hitung_kapasitas()<br/>SUDAH ADA produksi/services.py:53"]
    C4["core.pastikan_periode_terbuka()<br/>SUDAH ADA"]
    M2["PesananProduksi — BARU<br/>(bekas DetailPesananProduksi)"]
    M3["Resep · SesiProduksi<br/>SUDAH ADA"]
  end

  subgraph DB["PostgreSQL"]
    T1[("wo_work_order · wo_penugasan<br/>wo_pesan · wo_transisi")]
    T2[("produksi_pesanan — BARU<br/>wo_detail_produksi TIDAK jadi dibuat")]
    T3[("produksi_resep · produksi_sesi")]
  end

  FE1 --> U1 --> V0 --> V1 --> S1
  FE2 -.-> V1
  S1 --> C1 --> M1 --> T1

  FE3 -.-> U2 --> V2 --> S2 --> C2
  U3 --> V2
  C2 ==>|"WAJIB lewat sini"| C4
  C2 --> C3
  C2 --> M2 --> T2
  C3 --> M3 --> T3

  %% jembatan: pesanan menunjuk utas diskusinya, BUKAN sebaliknya
  M2 -.->|"FK string 'work_order.WorkOrder' (null)<br/>utas diskusi — tanpa import"| M1

  %% yang sengaja TIDAK ada
  M1 -.->|"work_order TIDAK mengimpor produksi<br/>fan-out tetap 1 (staff_user saja)"| XNONE{{"tidak ada"}}

  classDef baru fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20,stroke-width:2px
  classDef ada fill:#eceff1,stroke:#607d8b,color:#37474f
  classDef fe fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
  classDef inti fill:#ede7f6,stroke:#5e35b1,color:#311b92,stroke-width:3px
  classDef hilang fill:#f5f5f5,stroke:#bdbdbd,color:#9e9e9e,stroke-dasharray:5 3

  class FE1 fe
  class FE2 baru
  class FE3 hilang
  class U1,V0,V1,S1,C1,M1,T1 baru
  class U2,U3,V2,S2,M2,T2 baru
  class C3,C4,M3,T3 ada
  class C2 inti
  class XNONE hilang
